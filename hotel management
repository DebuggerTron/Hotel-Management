#include <stdio.h>

int main()
{
    int HotelLayout[5][8] = {0};
    int choice;
    int floor, room;

    printf("Hotel Management System\n");

    // keeps the system in a loop
    while (1) {
    printf("\nWhat Would You Like To Do?\n");
    printf("1. Check In\n");
    printf("2. Check Out\n");
    printf("3. View Room Information\n");
    printf("4. Exit\n");
    scanf("%d", &choice);

    if (choice == 1) {
        printf("\nEnter a Floor Number (1-5):");
        scanf("%d", &floor);
        printf("Enter a room (1-8):");
        scanf("%d", &room);

        // makes sure the employees are locked in and dont make silly mistakes :)
        if (floor > 5) {
            printf("\nYou're Fired!");
            break;
        }
        if (room > 8) {
            printf("\nYou're Fired!");
            break;
        }

        // converting entered numbers to array information
        floor--;
        room--;

        if (HotelLayout[floor][room] == 0) {
            HotelLayout[floor][room] = 1;
            printf("\nYou Are Checked-In!\n");
        }
        else printf("\nSorry, That Room Is Already Taken.\n");
    }
    else if (choice == 2) {
        printf("\nEnter a Floor Number (1-5):");
        scanf("%d", &floor);
        printf("Enter a room (1-8):");
        scanf("%d", &room);

        // makes sure the employees are locked in and dont make silly mistakes :)
        if (floor > 5) {
            printf("\nYou're Fired!");
            break;
        }
        if (room > 8) {
            printf("\nYou're Fired!");
            break;
        }

        // converting entered numbers to array information
        floor--;
        room--;

        if (HotelLayout[floor][room] == 1) {
            HotelLayout[floor][room] = 0;
            printf("\nYou Are Checked-Out!\n");
        }
        else printf("\nSorry, That Room Is Already Empty.\n");
    }
    else if (choice == 3) {
        printf("\nHere's The Current Room Status:\n");
        printf("0 = Available, 1 = Occupied\n\n");

        for (int i = 0; i < 5; i++) {
            printf("Floor %d: ", i + 1);
            for (int j = 0; j < 8; j++) {
                printf("%d ", HotelLayout[i][j]);
            }
            printf("\n");
        }
        printf("\n");
    }
    else if (choice == 4) {
        printf("Goodbye!\n");
        break; // this will exit the loop
    }
    else printf("Invalid choice.\n\n");
    }
    return 0;
}
